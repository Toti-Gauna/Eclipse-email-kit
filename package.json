{
  "name": "eclipse-email-kit",
  "version": "1.0.0",
  "description": "Sistema local de emails comerciales Eclipse",
  "directories": {
    "doc": "docs",
    "test": "tests"
  },
  "scripts": {
    "build": "node scripts/build.mjs",
    "generate": "node --use-env-proxy scripts/build.mjs",
    "validate": "node scripts/validate.mjs",
    "test": "node --test tests/*.test.mjs",
    "dev": "node scripts/serve.mjs",
    "qa": "node scripts/qa.mjs",
    "qa:extra": "node scripts/qa-extra.mjs",
    "qa:a11y": "node scripts/a11y.mjs",
    "build:pages": "node scripts/build-pages.mjs"
  },
  "keywords": [],
  "author": "",
  "license": "UNLICENSED",
  "type": "module",
  "dependencies": {
    "html-to-text": "9.0.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource-variable/big-shoulders-display": "5.3.0",
    "@fontsource-variable/fraunces": "5.3.0",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource/newsreader": "5.3.0",
    "@fontsource/source-sans-3": "5.3.1",
    "playwright": "1.56.1",
    "sharp": "0.34.4"
  },
  "private": true,
  "engines": {
    "node": ">=24"
  }
}
